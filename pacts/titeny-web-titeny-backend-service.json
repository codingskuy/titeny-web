      "providerStates": [
        {
          "name": "sesi OTP aktif dengan kode 123456"
        }
      ],
      "request": {
        "body": {
          "otp": "123456",
          "sesi_id": "sesi_abc123"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/auth/otp/verifikasi"
