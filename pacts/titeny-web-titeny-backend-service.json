    {
      "description": "permintaan daftar rekomendasi dengan limit",
      "providerStates": [
        {
          "name": "rekomendasi untuk zona PIN vendor tersedia"
        }
      ],
      "request": {
        "headers": {
          "X-Zona-PIN": "482013"
        },
        "method": "GET",
        "path": "/api/v1/rekomendasi",
        "query": {
          "limit": [
            "5"
          ],
          "zona": [
            "jakarta_timur"
          ]
        }
      },
      "response": {
        "body": {
          "data": [
            {
              "id": "rek_001",
              "status": "baru",
              "teks": [
                "Tambah stok cabai merah sekitar 300 kg."
              ],
              "zona": "jakarta_timur"
            }
          ],
          "next_cursor": null
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(baru|dikerjakan|selesai)$"
                }
              ]
            },
            "$.data[*].teks": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].zona": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {},
          "status": {}
        },
        "status": 200
      }
    },
    {
      "description": "permintaan harga H+1..H+7 dengan X-Zona-PIN",
      "providerStates": [
        {
          "name": "prediksi harga cabai merah di pasar zona PIN tersedia"
        }
      ],
      "request": {
        "headers": {
          "X-Zona-PIN": "482013"
        },
        "method": "GET",
        "path": "/api/v1/harga",
        "query": {
          "komoditas_id": [
            "cmd_cabai_merah"
          ],
          "pasar_id": [
            "psr_jakarta_timur_01"
          ]
        }
      },
      "response": {
        "body": {
          "deret": [
            {
              "harga_prediksi": 42500,
              "horizon": "H+1",
              "kepercayaan": "sedang",
              "rentang_atas": 46000,
              "rentang_bawah": 39000,
              "tanggal": "2026-10-05"
            }
          ],
          "dihitung_pada": "2026-10-04T04:00:12+07:00",
          "komoditas_id": "cmd_cabai_merah",
          "model_version": "harga_v1.0.0",
          "pasar_id": "psr_jakarta_timur_01"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.deret": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.deret[*].harga_prediksi": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.deret[*].horizon": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^H\\+[1-7]$"
                }
              ]
            },
            "$.deret[*].kepercayaan": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(tinggi|sedang|rendah)$"
                }
              ]
            },
            "$.deret[*].rentang_atas": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.deret[*].rentang_bawah": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.deret[*].tanggal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              ]
            },
            "$.dihitung_pada": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{4}-\\d{2}-\\d{2}T.+$"
                }
              ]
            },
            "$.model_version": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {},
          "status": {}
        },
        "status": 200
      }
    },
