        },
        "method": "POST",
        "path": "/api/v1/auth/login"
      },
      "response": {
        "body": {
          "otp_diperlukan": true,
          "sesi_id": "sesi_abc123"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.otp_diperlukan": {
              "combine": "AND",
